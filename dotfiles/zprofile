[[ -d /opt/homebrew/bin ]] && PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
[[ -d /usr/local/cuda/bin ]] && PATH="/usr/local/cuda/bin:$PATH"
[[ -d $HOME/bin ]] && PATH="$HOME/bin:$PATH"
[[ -d $HOME/.local/bin ]] && PATH="$HOME/.local/bin:$PATH"

if [[ -d /opt/homebrew/opt/ruby/bin ]]; then
  PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  if [[ ! -s ~/.cache/gemdir ]]; then
    mkdir -p ~/.cache
    gem environment gemdir >| ~/.cache/gemdir 2>/dev/null
  fi
  [[ -s ~/.cache/gemdir ]] && PATH="$(<~/.cache/gemdir)/bin:$PATH"
fi

export PATH
